# Set these in Vercel: Project Settings → Environment Variables
# For local dev: copy to .env.local and fill in values

# Fine-grained PAT — Scopes: Contents (read+write), Pull requests (read+write)
GITHUB_PAT=ghp_...
GITHUB_REPO_OWNER=aahilshaikh-twlbs
GITHUB_REPO_NAME=tl-skills

# Anthropic API key — used to generate rich SKILL.md content on submission
# Falls back to a simple template if not set
ANTHROPIC_API_KEY=sk-ant-...
